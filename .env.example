# Supabase Configuration
# Get these from your Supabase project settings (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Analytics & Monitoring
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# SENTRY_DSN=your-sentry-dsn

# Email Service (Resend) - Required for sending invitations
# Sign up at https://resend.com and get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your-api-key-here
RESEND_FROM_EMAIL=invitations@yourdomain.com
RESEND_FROM_NAME=EventKaro

# Important: You need to verify your domain in Resend to send emails
# For testing, you can use resend's test domain: onboarding@resend.dev

# App URL - Required for generating invitation links
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# Cron Job Authentication - Required for scheduled reminder delivery
# Generate a random secret: openssl rand -hex 32
CRON_SECRET=your-cron-secret-here

# Optional: WhatsApp (WhatsApp Business Cloud API) - for WhatsApp invitations/reminders
# Without these, WhatsApp sends are skipped (logged) and the app still works.
# WHATSAPP_API_TOKEN=your-whatsapp-cloud-api-token
# WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# Optional: SMS (Twilio) - for SMS reminders
# Without these, SMS sends are skipped (logged) and the app still works.
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# Optional: Payment Gateway (Razorpay for India)
# RAZORPAY_KEY_ID=your-razorpay-key-id
# RAZORPAY_KEY_SECRET=your-razorpay-key-secret
